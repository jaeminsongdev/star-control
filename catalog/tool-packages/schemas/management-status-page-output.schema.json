{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-control.local/schema/core/management-status-page-output-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "snapshot_revision",
    "snapshot_hash",
    "items",
    "returned_count",
    "total_count",
    "truncated",
    "next_cursor",
    "max_items",
    "max_bytes"
  ],
  "properties": {
    "schema_id": { "const": "star.management-status-page" },
    "schema_version": { "const": 1 },
    "snapshot_revision": { "type": "integer", "minimum": 0 },
    "snapshot_hash": { "$ref": "#/$defs/sha256" },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_version",
          "store_id",
          "store_scope",
          "management_store_version",
          "store_revision",
          "integrity_state",
          "open_mode"
        ]
      }
    },
    "returned_count": { "type": "integer", "minimum": 0, "maximum": 256 },
    "total_count": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "next_cursor": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "max_items": { "type": "integer", "minimum": 1, "maximum": 256 },
    "max_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
