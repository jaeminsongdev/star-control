{
  "$defs": {
    "ProductAuditStatusV1": {
      "enum": [
        "conformant",
        "blocked_external",
        "blocked"
      ],
      "type": "string"
    },
    "ProductFeatureSourceEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "cli_commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "codex_refs": {
          "items": {
            "$ref": "#/$defs/ProductSourceFileEvidenceV1"
          },
          "type": "array"
        },
        "codex_required": {
          "type": "boolean"
        },
        "feature_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "feature_id": {
          "type": "string"
        },
        "generated_schemas": {
          "items": {
            "$ref": "#/$defs/ProductSourceFileEvidenceV1"
          },
          "type": "array"
        },
        "handler_refs": {
          "items": {
            "$ref": "#/$defs/ProductSourceFileEvidenceV1"
          },
          "type": "array"
        },
        "mcp_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mcp_required": {
          "type": "boolean"
        },
        "owner_document": {
          "$ref": "#/$defs/ProductSourceFileEvidenceV1"
        },
        "product_surface_fingerprints": {
          "items": {
            "$ref": "#/$defs/Sha256Hash"
          },
          "type": "array"
        },
        "test_refs": {
          "$ref": "#/$defs/ProductFeatureTestEvidenceV1"
        }
      },
      "required": [
        "feature_id",
        "owner_document",
        "generated_schemas",
        "handler_refs",
        "cli_commands",
        "product_surface_fingerprints",
        "mcp_required",
        "mcp_actions",
        "codex_required",
        "codex_refs",
        "test_refs",
        "feature_fingerprint"
      ],
      "type": "object"
    },
    "ProductFeatureTestEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/$defs/ProductSourceFileEvidenceV1"
        },
        "negative": {
          "$ref": "#/$defs/ProductSourceFileEvidenceV1"
        },
        "positive": {
          "$ref": "#/$defs/ProductSourceFileEvidenceV1"
        },
        "recovery": {
          "$ref": "#/$defs/ProductSourceFileEvidenceV1"
        }
      },
      "required": [
        "positive",
        "negative",
        "failure",
        "recovery"
      ],
      "type": "object"
    },
    "ProductLifecycleEvidenceStatusV1": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/ReleaseArchitecture"
        },
        "candidate_artifact_set_digest": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "evidence_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "evidence_record_id": {
          "type": "string"
        },
        "runtime_verification": {
          "$ref": "#/$defs/RuntimeVerificationState"
        },
        "support_tier": {
          "$ref": "#/$defs/ReleaseSupportTier"
        }
      },
      "required": [
        "architecture",
        "support_tier",
        "runtime_verification",
        "evidence_record_id",
        "evidence_fingerprint",
        "candidate_artifact_set_digest"
      ],
      "type": "object"
    },
    "ProductProfileConformanceStatusV1": {
      "additionalProperties": false,
      "properties": {
        "activation_inputs_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "approval_path_verified": {
          "type": "boolean"
        },
        "conformance_policy_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "conformant": {
          "type": "boolean"
        },
        "covered_check_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "definition_hash": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "effective_config_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "project_context_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "required_check_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolution_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "rollback_path_verified": {
          "type": "boolean"
        },
        "source_definition_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "toolchain_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "unknown_outcome_path_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "definition_hash",
        "source_definition_fingerprint",
        "resolution_fingerprint",
        "activation_inputs_fingerprint",
        "conformance_policy_fingerprint",
        "project_context_fingerprint",
        "effective_config_fingerprint",
        "toolchain_fingerprint",
        "required_check_families",
        "covered_check_families",
        "approval_path_verified",
        "unknown_outcome_path_verified",
        "rollback_path_verified",
        "conformant"
      ],
      "type": "object"
    },
    "ProductProfileSourceEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "activation_inputs_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "allowed_effect_classes": {
          "items": {
            "$ref": "#/$defs/ProfileEffectClassV1"
          },
          "type": "array"
        },
        "approval_checkpoints": {
          "items": {
            "$ref": "#/$defs/ProfileApprovalCheckpointV1"
          },
          "type": "array"
        },
        "conformance_policy_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "conformance_refs": {
          "items": {
            "$ref": "#/$defs/ProductSourceFileEvidenceV1"
          },
          "type": "array"
        },
        "definition_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "definition_source": {
          "$ref": "#/$defs/ProductSourceFileEvidenceV1"
        },
        "descriptor_definition_hash": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "gate_phases": {
          "items": {
            "$ref": "#/$defs/ProfileGatePhaseV1"
          },
          "type": "array"
        },
        "permission_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "permission_floor": {
          "$ref": "#/$defs/ProfilePermissionFloorV1"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "required_check_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_rule_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rollback_policy": {
          "$ref": "#/$defs/ProfileRollbackPolicyV1"
        },
        "unknown_outcome_policy": {
          "$ref": "#/$defs/ProfileUnknownOutcomePolicyV1"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "definition_fingerprint",
        "descriptor_definition_hash",
        "definition_source",
        "activation_inputs_fingerprint",
        "conformance_policy_fingerprint",
        "required_rule_families",
        "required_check_families",
        "gate_phases",
        "permission_actions",
        "approval_checkpoints",
        "allowed_effect_classes",
        "permission_floor",
        "unknown_outcome_policy",
        "rollback_policy",
        "conformance_refs"
      ],
      "type": "object"
    },
    "ProductSourceEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "feature_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/ProductFeatureSourceEvidenceV1"
          },
          "type": "array"
        },
        "generated_schema_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "generated_schema_manifest_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "inventory_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "mcp_matrix_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mcp_matrix_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "profile_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ProductProfileSourceEvidenceV1"
          },
          "type": "array"
        },
        "runtime_executables": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "stable_error_catalog_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "stable_error_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "source_fingerprint",
        "inventory_fingerprint",
        "generated_schema_manifest_fingerprint",
        "stable_error_catalog_fingerprint",
        "mcp_matrix_fingerprint",
        "feature_count",
        "profile_count",
        "runtime_executables",
        "generated_schema_count",
        "stable_error_count",
        "mcp_matrix_count",
        "features",
        "profiles",
        "evidence_fingerprint"
      ],
      "type": "object"
    },
    "ProductSourceFileEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "path",
        "source_sha256"
      ],
      "type": "object"
    },
    "ProfileApprovalCheckpointV1": {
      "enum": [
        "network",
        "download",
        "debug_attach",
        "dependency_change",
        "patch_apply",
        "migration_execute",
        "destructive_migration",
        "unknown_field_loss",
        "cross_project_effect",
        "language_cutover",
        "remote_write",
        "release_publish"
      ],
      "type": "string"
    },
    "ProfileEffectClassV1": {
      "enum": [
        "read",
        "plan",
        "validate",
        "local_state_write",
        "workspace_mutation",
        "network_read",
        "remote_write",
        "publish"
      ],
      "type": "string"
    },
    "ProfileGatePhaseV1": {
      "enum": [
        "during_stage",
        "stage_exit",
        "goal_exit",
        "patch_pre_apply",
        "patch_post_apply",
        "merge",
        "migration_pre_execute",
        "migration_post_execute",
        "migration_post_rollback",
        "performance_compare",
        "language_cutover",
        "release",
        "release_preflight",
        "release_build",
        "release_verify",
        "release_package",
        "release_install_lifecycle",
        "release_ready",
        "release_publish_preflight",
        "release_publish_verify"
      ],
      "type": "string"
    },
    "ProfilePermissionFloorV1": {
      "enum": [
        "local_read_only",
        "exact_prompt",
        "exact_durable_approval",
        "deny_external"
      ],
      "type": "string"
    },
    "ProfileRollbackPolicyV1": {
      "enum": [
        "not_applicable",
        "recovery_plan_required",
        "backup_and_restore_required",
        "compensation_plan_required"
      ],
      "type": "string"
    },
    "ProfileUnknownOutcomePolicyV1": {
      "enum": [
        "preserve_and_stop",
        "preserve_and_reconcile"
      ],
      "type": "string"
    },
    "ReleaseArchitecture": {
      "enum": [
        "x64",
        "arm64"
      ],
      "type": "string"
    },
    "ReleaseStatus": {
      "enum": [
        "draft",
        "candidate",
        "blocked",
        "blocked_external",
        "ready",
        "approved",
        "publishing",
        "publish_outcome_unknown",
        "published",
        "rollback_required",
        "withdrawn"
      ],
      "type": "string"
    },
    "ReleaseSupportTier": {
      "enum": [
        "stable",
        "preview"
      ],
      "type": "string"
    },
    "RuntimeVerificationState": {
      "enum": [
        "native_verified",
        "native_unverified",
        "failed"
      ],
      "type": "string"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.final-product-audit-v2:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_set_digest": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "audit_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "external_gate_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "internal_conformance": {
      "type": "boolean"
    },
    "lifecycle_statuses": {
      "items": {
        "$ref": "#/$defs/ProductLifecycleEvidenceStatusV1"
      },
      "type": "array"
    },
    "m11_profile_conformant": {
      "type": "boolean"
    },
    "profile_catalog_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "profile_statuses": {
      "items": {
        "$ref": "#/$defs/ProductProfileConformanceStatusV1"
      },
      "type": "array"
    },
    "release_manifest_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "release_manifest_id": {
      "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "release_status": {
      "$ref": "#/$defs/ReleaseStatus"
    },
    "schema_id": {
      "const": "star.final-product-audit-v2",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "source_evidence": {
      "$ref": "#/$defs/ProductSourceEvidenceV1"
    },
    "status": {
      "$ref": "#/$defs/ProductAuditStatusV1"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "release_manifest_id",
    "release_manifest_fingerprint",
    "artifact_set_digest",
    "source_evidence",
    "profile_catalog_fingerprint",
    "profile_statuses",
    "m11_profile_conformant",
    "lifecycle_statuses",
    "internal_conformance",
    "release_status",
    "status",
    "audit_fingerprint"
  ],
  "title": "FinalProductAuditV2",
  "type": "object"
}