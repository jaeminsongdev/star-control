{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "diff",
        "screenshot",
        "trace",
        "manifest",
        "input",
        "output",
        "checkpoint",
        "change_set",
        "review_pack"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus"
        },
        "relative_path": {
          "type": "string"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer",
        "redaction_status",
        "retention_class"
      ],
      "type": "object"
    },
    "ExternalAnalysisCompleteness": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "unverified",
        "timed_out",
        "cancelled",
        "flaky",
        "failed"
      ],
      "type": "string"
    },
    "ExternalAnalysisEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "completeness": {
          "$ref": "#/$defs/ExternalAnalysisCompleteness"
        },
        "config_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "content_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "environment_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "evidence_id": {
          "type": "string"
        },
        "executable_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "input_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "normalized_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ExternalAnalysisProtocolV1"
        },
        "provider_id": {
          "type": "string"
        },
        "provider_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "evidence_id",
        "project_id",
        "provider_id",
        "protocol",
        "config_fingerprint",
        "input_fingerprint",
        "source_fingerprint",
        "environment_fingerprint",
        "started_at",
        "completed_at",
        "completeness",
        "content_fingerprint"
      ],
      "type": "object"
    },
    "ExternalAnalysisProtocolV1": {
      "additionalProperties": false,
      "properties": {
        "detail_level": {
          "$ref": "#/$defs/ProtocolDetailLevel"
        },
        "machine_readable": {
          "type": "boolean"
        },
        "media_type": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "schema_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "stability": {
          "$ref": "#/$defs/ProtocolStability"
        }
      },
      "required": [
        "protocol_id",
        "protocol_version",
        "media_type",
        "stability",
        "detail_level",
        "machine_readable"
      ],
      "type": "object"
    },
    "ProducerRef": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "product_version",
        "build_id",
        "platform"
      ],
      "type": "object"
    },
    "ProtocolDetailLevel": {
      "enum": [
        "structured",
        "exit_classification",
        "raw_only"
      ],
      "type": "string"
    },
    "ProtocolStability": {
      "enum": [
        "stable",
        "unstable",
        "human_text"
      ],
      "type": "string"
    },
    "RedactionStatus": {
      "enum": [
        "not_needed",
        "redacted",
        "quarantined",
        "unknown"
      ],
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "temporary",
        "run",
        "evidence",
        "hold"
      ],
      "type": "string"
    },
    "RuntimeSafetyProviderKindV1": {
      "enum": [
        "sanitizer",
        "generator",
        "doctest",
        "loom"
      ],
      "type": "string"
    },
    "RuntimeSafetyStateV1": {
      "enum": [
        "pass",
        "fail",
        "timed_out",
        "cancelled",
        "unavailable",
        "unverified"
      ],
      "type": "string"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.runtime-safety-observation:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cancelled": {
      "type": "boolean"
    },
    "evidence": {
      "$ref": "#/$defs/ExternalAnalysisEvidenceV1"
    },
    "finding_refs": {
      "items": {
        "pattern": "^fnd_[a-z2-7]{52}$",
        "type": "string"
      },
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "observation_id": {
      "type": "string"
    },
    "project_declares_toolchain_or_test": {
      "type": "boolean"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "provider_kind": {
      "$ref": "#/$defs/RuntimeSafetyProviderKindV1"
    },
    "schema_id": {
      "const": "star.runtime-safety-observation",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/RuntimeSafetyStateV1"
    },
    "target": {
      "type": "string"
    },
    "timeout_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "observation_id",
    "project_id",
    "provider_kind",
    "evidence",
    "target",
    "project_declares_toolchain_or_test",
    "timeout_ms",
    "cancelled",
    "finding_refs",
    "state"
  ],
  "title": "RuntimeSafetyObservationV1",
  "type": "object"
}