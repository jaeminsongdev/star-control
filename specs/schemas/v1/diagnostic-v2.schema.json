{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "diff",
        "screenshot",
        "trace",
        "manifest",
        "input",
        "output",
        "checkpoint",
        "change_set",
        "review_pack"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus"
        },
        "relative_path": {
          "type": "string"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer",
        "redaction_status",
        "retention_class"
      ],
      "type": "object"
    },
    "CatalogRef": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "type": "string"
        },
        "format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "item_version": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "catalog_id",
        "format_version",
        "item_version",
        "sha256"
      ],
      "type": "object"
    },
    "DiagnosticConfidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "DiagnosticEvidenceRefV2": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document": {
              "$ref": "#/$defs/DocumentRef"
            },
            "kind": {
              "const": "document",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "document"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "finding_fingerprint": {
              "$ref": "#/$defs/Sha256Hash"
            },
            "finding_id": {
              "pattern": "^fnd_[a-z2-7]{52}$",
              "type": "string"
            },
            "kind": {
              "const": "finding",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "finding_id",
            "finding_fingerprint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic_ref": {
              "$ref": "#/$defs/DiagnosticRef"
            },
            "kind": {
              "const": "diagnostic",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostic_ref"
          ],
          "type": "object"
        }
      ]
    },
    "DiagnosticObservationStatusV2": {
      "enum": [
        "confirmed",
        "suspected",
        "unverified"
      ],
      "type": "string"
    },
    "DiagnosticRef": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_id": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "diagnostic_id",
        "sequence",
        "sha256"
      ],
      "type": "object"
    },
    "DiagnosticScopeV2": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "goal_id": {
              "pattern": "^gol_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "kind": {
              "const": "goal",
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "goal_id",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "goal_id": {
              "pattern": "^gol_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "kind": {
              "const": "run",
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "run_id": {
              "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "goal_id",
            "run_id",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "goal_id": {
              "pattern": "^gol_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "kind": {
              "const": "stage",
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "run_id": {
              "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "stage_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "goal_id",
            "run_id",
            "stage_id",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "validation_run",
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "validation_run_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "validation_run_id",
            "revision"
          ],
          "type": "object"
        }
      ]
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "type": "string"
    },
    "DiagnosticStatus": {
      "enum": [
        "confirmed",
        "suspected",
        "unverified",
        "suppressed",
        "resolved"
      ],
      "type": "string"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "schema_id",
        "document_id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "LocationRef": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/ProjectPathRef"
        },
        "start": {
          "$ref": "#/$defs/TextPosition"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "start"
      ],
      "type": "object"
    },
    "ProducerRef": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "product_version",
        "build_id",
        "platform"
      ],
      "type": "object"
    },
    "ProjectPathKind": {
      "enum": [
        "file",
        "directory"
      ],
      "type": "string"
    },
    "ProjectPathRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "path_kind": {
          "$ref": "#/$defs/ProjectPathKind"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "path",
        "path_kind"
      ],
      "type": "object"
    },
    "RedactionStatus": {
      "enum": [
        "not_needed",
        "redacted",
        "quarantined",
        "unknown"
      ],
      "type": "string"
    },
    "Remediation": {
      "additionalProperties": false,
      "properties": {
        "action_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "automatic_fix_available": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "automatic_fix_available"
      ],
      "type": "object"
    },
    "RetentionClass": {
      "enum": [
        "temporary",
        "run",
        "evidence",
        "hold"
      ],
      "type": "string"
    },
    "RuleRefV2": {
      "additionalProperties": false,
      "properties": {
        "definition_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "fingerprint_contract_version": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "rule_id": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "definition_fingerprint",
        "fingerprint_contract_version"
      ],
      "type": "object"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "TextPosition": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    }
  },
  "$id": "urn:star-control:schema:star.diagnostic:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocking": {
      "type": "boolean"
    },
    "code": {
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/DiagnosticConfidence"
    },
    "diagnostic_id": {
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/DiagnosticEvidenceRefV2"
      },
      "type": "array"
    },
    "fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "first_seen_at": {
      "format": "date-time",
      "type": "string"
    },
    "last_seen_at": {
      "format": "date-time",
      "type": "string"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/LocationRef"
      },
      "type": "array"
    },
    "message": {
      "type": "string"
    },
    "observation_status": {
      "$ref": "#/$defs/DiagnosticObservationStatusV2"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "package_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_item_id": {
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ProducerRef"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "remediation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Remediation"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_ref": {
      "$ref": "#/$defs/RuleRefV2"
    },
    "schema_id": {
      "const": "star.diagnostic",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/DiagnosticScopeV2"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "severity": {
      "$ref": "#/$defs/DiagnosticSeverity"
    },
    "status": {
      "$ref": "#/$defs/DiagnosticStatus"
    },
    "subject_binding_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "validation_run_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "diagnostic_id",
    "sequence",
    "code",
    "rule_ref",
    "producer",
    "title",
    "message",
    "severity",
    "confidence",
    "status",
    "observation_status",
    "blocking",
    "project_id",
    "plan_item_id",
    "validation_run_id",
    "scope",
    "locations",
    "evidence_refs",
    "observed_at",
    "first_seen_at",
    "last_seen_at",
    "fingerprint"
  ],
  "title": "DiagnosticV2",
  "type": "object"
}