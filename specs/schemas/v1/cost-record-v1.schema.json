{
  "$defs": {
    "CostScopeKindV1": {
      "enum": [
        "goal",
        "stage",
        "attempt",
        "validation_run",
        "external_action",
        "evaluation"
      ],
      "type": "string"
    },
    "CostUsageV1": {
      "additionalProperties": false,
      "properties": {
        "provider_evidence_ref": {
          "type": "string"
        },
        "quantity": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "unit",
        "quantity",
        "provider_evidence_ref"
      ],
      "type": "object"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "VerifiedMonetaryCostV1": {
      "additionalProperties": false,
      "properties": {
        "amount_microunits": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "price_source_ref": {
          "type": "string"
        },
        "provider_statement_ref": {
          "type": "string"
        }
      },
      "required": [
        "amount_microunits",
        "currency",
        "price_source_ref",
        "provider_statement_ref"
      ],
      "type": "object"
    }
  },
  "$id": "urn:star-control:schema:star.cost-record:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "cost_record_id": {
      "type": "string"
    },
    "estimated": {
      "type": "boolean"
    },
    "measured_at": {
      "format": "date-time",
      "type": "string"
    },
    "measurement_unavailable": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "monetary_cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifiedMonetaryCostV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "paid_action": {
      "type": "boolean"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "provider_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_id": {
      "const": "star.cost-record",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "scope_kind": {
      "$ref": "#/$defs/CostScopeKindV1"
    },
    "scope_ref": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "usage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CostUsageV1"
      },
      "type": "array"
    },
    "validation_run_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "cost_record_id",
    "revision",
    "project_id",
    "scope_kind",
    "scope_ref",
    "source",
    "estimated",
    "paid_action",
    "measured_at",
    "provider_evidence_refs",
    "content_fingerprint"
  ],
  "title": "CostRecordV1",
  "type": "object"
}