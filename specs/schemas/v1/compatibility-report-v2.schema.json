{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "diff",
        "screenshot",
        "trace",
        "manifest",
        "input",
        "output",
        "checkpoint",
        "change_set",
        "review_pack"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus"
        },
        "relative_path": {
          "type": "string"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer",
        "redaction_status",
        "retention_class"
      ],
      "type": "object"
    },
    "CompatibilityClass": {
      "enum": [
        "unchanged",
        "compatible",
        "additive",
        "breaking",
        "unknown"
      ],
      "type": "string"
    },
    "CompatibilityProviderKindV1": {
      "enum": [
        "buf",
        "oasdiff",
        "cargo_semver_checks",
        "libabigail"
      ],
      "type": "string"
    },
    "CompatibilityProviderObservationV1": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/CompatibilityClass"
        },
        "evidence": {
          "$ref": "#/$defs/ExternalAnalysisEvidenceV1"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "machine_detail_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "provider_kind": {
          "$ref": "#/$defs/CompatibilityProviderKindV1"
        },
        "raw_exit_classification": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider_kind",
        "evidence",
        "classification",
        "machine_detail_count"
      ],
      "type": "object"
    },
    "ConsumerImpactRecord": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/CompatibilityClass"
        },
        "consumer_ref": {
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "migration_required": {
          "type": "boolean"
        },
        "minimum_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/EvaluationState"
        },
        "surface_id": {
          "type": "string"
        }
      },
      "required": [
        "consumer_ref",
        "surface_id",
        "classification",
        "migration_required",
        "state"
      ],
      "type": "object"
    },
    "ContractChangeRecord": {
      "additionalProperties": false,
      "properties": {
        "after_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_kind": {
          "$ref": "#/$defs/SurfaceChangeKind"
        },
        "classification": {
          "$ref": "#/$defs/CompatibilityClass"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ContractSurfaceKind"
        },
        "rule_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "surface_id": {
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "kind",
        "change_kind",
        "classification",
        "rule_id",
        "summary"
      ],
      "type": "object"
    },
    "ContractSurfaceKind": {
      "enum": [
        "api",
        "cli",
        "schema",
        "file_format",
        "config",
        "error_code"
      ],
      "type": "string"
    },
    "CoverageState": {
      "enum": [
        "complete",
        "partial",
        "unverified"
      ],
      "type": "string"
    },
    "EvaluationState": {
      "enum": [
        "pass",
        "block",
        "human_review",
        "unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "ExternalAnalysisCompleteness": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "unverified",
        "timed_out",
        "cancelled",
        "flaky",
        "failed"
      ],
      "type": "string"
    },
    "ExternalAnalysisEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "completeness": {
          "$ref": "#/$defs/ExternalAnalysisCompleteness"
        },
        "config_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "content_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "environment_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "evidence_id": {
          "type": "string"
        },
        "executable_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "input_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "normalized_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ExternalAnalysisProtocolV1"
        },
        "provider_id": {
          "type": "string"
        },
        "provider_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "evidence_id",
        "project_id",
        "provider_id",
        "protocol",
        "config_fingerprint",
        "input_fingerprint",
        "source_fingerprint",
        "environment_fingerprint",
        "started_at",
        "completed_at",
        "completeness",
        "content_fingerprint"
      ],
      "type": "object"
    },
    "ExternalAnalysisProtocolV1": {
      "additionalProperties": false,
      "properties": {
        "detail_level": {
          "$ref": "#/$defs/ProtocolDetailLevel"
        },
        "machine_readable": {
          "type": "boolean"
        },
        "media_type": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "schema_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "stability": {
          "$ref": "#/$defs/ProtocolStability"
        }
      },
      "required": [
        "protocol_id",
        "protocol_version",
        "media_type",
        "stability",
        "detail_level",
        "machine_readable"
      ],
      "type": "object"
    },
    "ProducerRef": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "product_version",
        "build_id",
        "platform"
      ],
      "type": "object"
    },
    "ProtocolDetailLevel": {
      "enum": [
        "structured",
        "exit_classification",
        "raw_only"
      ],
      "type": "string"
    },
    "ProtocolStability": {
      "enum": [
        "stable",
        "unstable",
        "human_text"
      ],
      "type": "string"
    },
    "RedactionStatus": {
      "enum": [
        "not_needed",
        "redacted",
        "quarantined",
        "unknown"
      ],
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "temporary",
        "run",
        "evidence",
        "hold"
      ],
      "type": "string"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SurfaceChangeKind": {
      "enum": [
        "unchanged",
        "added",
        "removed",
        "modified",
        "renamed",
        "coverage_changed"
      ],
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.compatibility-report:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_snapshot_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "baseline_snapshot_ref": {
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/ContractChangeRecord"
      },
      "type": "array"
    },
    "completeness": {
      "$ref": "#/$defs/CoverageState"
    },
    "consumer_impacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConsumerImpactRecord"
      },
      "type": "array"
    },
    "current_snapshot_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "current_snapshot_ref": {
      "type": "string"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "manifest_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "manifest_ref": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/CompatibilityClass"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "provider_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CompatibilityProviderObservationV1"
      },
      "type": "array"
    },
    "report_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "report_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "star.compatibility-report",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "report_id",
    "project_id",
    "manifest_ref",
    "manifest_fingerprint",
    "baseline_snapshot_ref",
    "baseline_snapshot_fingerprint",
    "current_snapshot_ref",
    "current_snapshot_fingerprint",
    "changes",
    "outcome",
    "completeness",
    "report_fingerprint"
  ],
  "title": "CompatibilityReportV2",
  "type": "object"
}