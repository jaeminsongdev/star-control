{
  "$defs": {
    "ConfigOverrideV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 160,
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ConfigValueV1"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "ConfigValueV1": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "string",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "string_set",
              "type": "string"
            },
            "value": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "json",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "type": "string"
    },
    "WaitMode": {
      "enum": [
        "auto",
        "sync",
        "accepted"
      ],
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.mcp.star_tool_call.input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": true,
      "type": "object"
    },
    "client_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_overrides": {
      "items": {
        "$ref": "#/$defs/ConfigOverrideV1"
      },
      "maxItems": 128,
      "type": "array"
    },
    "descriptor_hash": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "expected_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_timeout_ms": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "tool_id": {
      "type": "string"
    },
    "wait_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/WaitMode"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tool_id",
    "descriptor_hash",
    "arguments"
  ],
  "title": "CallInput",
  "type": "object"
}