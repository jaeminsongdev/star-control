        },
        "finding_id": {
          "pattern": "^fnd_[a-z2-7]{52}$",
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope_revision": {
          "pattern": "^prv_[a-z2-7]{52}$",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/DispositionStatus"
        }
