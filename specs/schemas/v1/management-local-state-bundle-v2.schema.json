{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "auth_source": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id",
        "display_name",
        "auth_source"
      ],
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "codex",
        "system",
        "controller",
        "mcp",
        "tool"
      ],
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "diff",
        "screenshot",
        "trace",
        "manifest",
        "input",
        "output",
        "checkpoint",
        "change_set",
        "review_pack"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus"
        },
        "relative_path": {
          "type": "string"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer",
        "redaction_status",
        "retention_class"
      ],
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^bas_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "finding_fingerprints": {
          "items": {
            "$ref": "#/$defs/Sha256Hash"
          },
          "type": "array"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "project_revision_id": {
          "pattern": "^prv_[a-z2-7]{52}$",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rule_set_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "scan_config_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope_kind": {
          "$ref": "#/$defs/BaselineScope"
        },
        "set_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "status": {
          "$ref": "#/$defs/BaselineStatus"
        },
        "workspace_snapshot_id": {
          "pattern": "^wsp_[a-z2-7]{52}$",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "baseline_id",
        "revision",
        "scope_kind",
        "project_id",
        "project_revision_id",
        "workspace_snapshot_id",
        "scan_config_fingerprint",
        "rule_set_fingerprint",
        "finding_fingerprints",
        "set_fingerprint",
        "created_at",
        "reason",
        "reviewed",
        "status"
      ],
      "type": "object"
    },
    "BaselineEntryV2": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "entry_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "rule_ref": {
          "$ref": "#/$defs/RuleRefV2"
        },
        "scope_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        }
      },
      "required": [
        "diagnostic_fingerprint",
        "rule_ref",
        "severity",
        "scope_fingerprint",
        "entry_fingerprint"
      ],
      "type": "object"
    },
    "BaselineScope": {
      "enum": [
        "shared",
        "local"
      ],
      "type": "string"
    },
    "BaselineStatus": {
      "enum": [
        "active",
        "superseded",
        "invalid"
      ],
      "type": "string"
    },
    "BaselineV2": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "baseline_id": {
          "pattern": "^bas_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/BaselineEntryV2"
          },
          "type": "array"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rule_set_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "set_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "subject_binding_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "baseline_id",
        "revision",
        "project_id",
        "subject_binding_fingerprint",
        "rule_set_fingerprint",
        "entries",
        "created_at",
        "reason",
        "reviewed",
        "active",
        "set_fingerprint"
      ],
      "type": "object"
    },
    "ChangePlan": {
      "additionalProperties": false,
      "properties": {
        "change_plan_id": {
          "pattern": "^cpl_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "expected_paths": {
          "items": {
            "minLength": 1,
            "pattern": "^[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$",
            "type": "string"
          },
          "type": "array"
        },
        "finding_refs": {
          "items": {
            "pattern": "^fnd_[a-z2-7]{52}$",
            "type": "string"
          },
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "permission_plan_ref": {
          "type": "string"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/Sha256Hash"
          },
          "type": "array"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "recipe_refs": {
          "items": {
            "$ref": "#/$defs/ChangeRecipeRef"
          },
          "type": "array"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "risk": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ChangePlanStatus"
        },
        "target_workspace_snapshot_id": {
          "pattern": "^wsp_[a-z2-7]{52}$",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        },
        "validation_plan_ref": {
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "change_plan_id",
        "revision",
        "project_id",
        "target_workspace_snapshot_id",
        "finding_refs",
        "recipe_refs",
        "parameters",
        "expected_paths",
        "preconditions",
        "risk",
        "permission_plan_ref",
        "validation_plan_ref",
        "status",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "ChangePlanStatus": {
      "enum": [
        "draft",
        "ready",
        "applied",
        "validated",
        "blocked",
        "abandoned"
