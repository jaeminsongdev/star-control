      "required": [
        "schema_id",
        "schema_version",
        "disposition_id",
        "revision",
        "finding_id",
        "finding_fingerprint",
        "decision",
        "reason_code",
        "reason",
        "decided_at",
        "provenance",
        "status"
      ],
      "type": "object"
    },
