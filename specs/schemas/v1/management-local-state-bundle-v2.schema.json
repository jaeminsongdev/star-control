          "type": "string"
        }
      },
      "required": [
        "recipe_id",
        "recipe_version",
        "definition_fingerprint"
      ],
      "type": "object"
    },
    "DecisionScopeConstraintV2": {
      "additionalProperties": false,
      "properties": {
        "gate_phases": {
          "items": {
            "$ref": "#/$defs/GatePhaseV2"
