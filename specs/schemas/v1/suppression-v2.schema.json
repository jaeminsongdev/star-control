{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "auth_source": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id",
        "display_name",
        "auth_source"
      ],
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "codex",
        "system",
        "controller",
        "mcp",
        "tool"
      ],
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "diff",
        "screenshot",
        "trace",
        "manifest",
        "input",
        "output",
        "checkpoint",
        "change_set",
        "review_pack"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "$ref": "#/$defs/RedactionStatus"
        },
        "relative_path": {
          "type": "string"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer",
        "redaction_status",
        "retention_class"
      ],
      "type": "object"
    },
    "DecisionScopeConstraintV2": {
      "additionalProperties": false,
      "properties": {
        "gate_phases": {
          "items": {
            "$ref": "#/$defs/GatePhaseV2"
          },
          "type": "array"
        },
        "package_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "items": {
            "minLength": 1,
            "pattern": "^[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$",
            "type": "string"
          },
          "type": "array"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "symbol_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project_id",
        "paths",
        "symbol_ids",
        "gate_phases"
      ],
      "type": "object"
    },
    "DecisionSubjectKindV2": {
      "enum": [
        "finding",
        "diagnostic"
      ],
      "type": "string"
    },
    "DiagnosticEvidenceRefV2": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document": {
              "$ref": "#/$defs/DocumentRef"
            },
            "kind": {
              "const": "document",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "document"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "finding_fingerprint": {
              "$ref": "#/$defs/Sha256Hash"
            },
            "finding_id": {
              "pattern": "^fnd_[a-z2-7]{52}$",
              "type": "string"
            },
            "kind": {
              "const": "finding",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "finding_id",
            "finding_fingerprint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic_ref": {
              "$ref": "#/$defs/DiagnosticRef"
            },
            "kind": {
              "const": "diagnostic",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostic_ref"
          ],
          "type": "object"
        }
      ]
    },
    "DiagnosticRef": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_id": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "diagnostic_id",
        "sequence",
        "sha256"
      ],
      "type": "object"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "schema_id",
        "document_id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "GatePhaseV2": {
      "enum": [
        "during_stage",
        "goal_exit",
        "patch_pre_apply",
        "patch_post_apply"
      ],
      "type": "string"
    },
    "ProducerRef": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "product_version",
        "build_id",
        "platform"
      ],
      "type": "object"
    },
    "RedactionStatus": {
      "enum": [
        "not_needed",
        "redacted",
        "quarantined",
        "unknown"
      ],
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "temporary",
        "run",
        "evidence",
        "hold"
      ],
      "type": "string"
    },
    "RuleRefV2": {
      "additionalProperties": false,
      "properties": {
        "definition_fingerprint": {
          "$ref": "#/$defs/Sha256Hash"
        },
        "fingerprint_contract_version": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "rule_id": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "definition_fingerprint",
        "fingerprint_contract_version"
      ],
      "type": "object"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SuppressionStatus": {
      "enum": [
        "active",
        "expired",
        "revoked",
        "stale"
      ],
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.suppression:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "content_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "justification": {
      "type": [
        "string",
        "null"
      ]
    },
    "permanent": {
      "type": "boolean"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reason_code": {
      "type": "string"
    },
    "review_evidence_refs": {
      "items": {
        "$ref": "#/$defs/DiagnosticEvidenceRefV2"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "rule_ref_constraint": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleRefV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_id": {
      "const": "star.suppression",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "scope_constraint": {
      "$ref": "#/$defs/DecisionScopeConstraintV2"
    },
    "selector": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SuppressionStatus"
    },
    "subject_binding_constraint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_kind": {
      "$ref": "#/$defs/DecisionSubjectKindV2"
    },
    "suppression_id": {
      "pattern": "^sup_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "suppression_id",
    "revision",
    "project_id",
    "subject_kind",
    "selector",
    "scope_constraint",
    "reason_code",
    "reason",
    "created_at",
    "permanent",
    "approved_by",
    "review_evidence_refs",
    "status",
    "provenance",
    "content_fingerprint"
  ],
  "title": "SuppressionV2",
  "type": "object"
}