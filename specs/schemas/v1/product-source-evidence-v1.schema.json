    "ProfileApprovalCheckpointV1": {
      "enum": [
        "network",
        "download",
        "debug_attach",
        "dependency_change",
        "patch_apply",
        "migration_execute",
        "destructive_migration",
        "unknown_field_loss",
        "cross_project_effect",
        "language_cutover",
        "remote_write",
        "release_publish"
      ],
      "type": "string"
    },
    "ProfileEffectClassV1": {
      "enum": [
        "read",
        "plan",
        "validate",
        "local_state_write",
        "workspace_mutation",
        "network_read",
        "remote_write",
        "publish"
      ],
      "type": "string"
    },
    "ProfileGatePhaseV1": {
      "enum": [
        "during_stage",
        "stage_exit",
        "goal_exit",
        "patch_pre_apply",
        "patch_post_apply",
        "merge",
        "migration_pre_execute",
        "migration_post_execute",
        "migration_post_rollback",
        "performance_compare",
        "language_cutover",
        "release",
        "release_preflight",
        "release_build",
        "release_verify",
        "release_package",
        "release_install_lifecycle",
        "release_ready",
        "release_publish_preflight",
        "release_publish_verify"
      ],
      "type": "string"
    },
    "ProfilePermissionFloorV1": {
      "enum": [
        "local_read_only",
        "exact_prompt",
        "exact_durable_approval",
        "deny_external"
      ],
      "type": "string"
    },
    "ProfileRollbackPolicyV1": {
      "enum": [
        "not_applicable",
        "recovery_plan_required",
        "backup_and_restore_required",
        "compensation_plan_required"
      ],
      "type": "string"
    },
    "ProfileUnknownOutcomePolicyV1": {
      "enum": [
        "preserve_and_stop",
        "preserve_and_reconcile"
      ],
      "type": "string"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.product-source-evidence:v1",
