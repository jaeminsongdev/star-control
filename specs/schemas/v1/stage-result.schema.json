{
  "$defs": {
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hash"
        }
      },
      "required": [
        "schema_id",
        "document_id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "Sha256Hash": {
      "description": "Contract representation of a SHA-256 digest.  The prefix is always present.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StageProjectEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_bundle_ref": {
          "$ref": "#/$defs/DocumentRef"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "evidence_bundle_ref"
      ],
      "type": "object"
    },
    "StageResultOutcomeV1": {
      "enum": [
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "outcome_unknown"
      ],
      "type": "string"
    }
  },
  "$id": "urn:star-control:schema:star.stage-result:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_criteria": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution_record_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "goal_id": {
      "pattern": "^gol_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/StageResultOutcomeV1"
    },
    "project_evidence": {
      "items": {
        "$ref": "#/$defs/StageProjectEvidenceV1"
      },
      "type": "array"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "recovery_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_fingerprint": {
      "$ref": "#/$defs/Sha256Hash"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_id": {
      "const": "star.stage-result",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "source_effect_may_have_started": {
      "type": "boolean"
    },
    "stage_graph_ref": {
      "$ref": "#/$defs/DocumentRef"
    },
    "stage_ref": {
      "$ref": "#/$defs/DocumentRef"
    },
    "stage_result_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "stage_result_id",
    "revision",
    "goal_id",
    "stage_graph_ref",
    "stage_ref",
    "outcome",
    "completed_criteria",
    "project_evidence",
    "source_effect_may_have_started",
    "recorded_at",
    "result_fingerprint"
  ],
  "title": "StageResultV1",
  "type": "object"
}